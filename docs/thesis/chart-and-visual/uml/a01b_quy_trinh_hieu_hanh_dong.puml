@startuml
!include ../style.iuml

|Người phụ trách|
start
:Đặt câu hỏi điều tra;
repeat
  |HappyNest|
  :Tác tử tra cứu,\nghi bằng chứng;
  |Dịch vụ AI|
  :Tổng hợp nhận định;
  |Người phụ trách|
