@startuml
!include ../style.iuml

!pragma layout smetana
hide members
class User <<Tài khoản>>
class Product <<Sản phẩm>>
class ProductSchema <<Lược đồ dữ liệu>>
class Taxonomy <<Chủ đề>>
class Import <<Lượt nhập>>
class Feedback <<Phản hồi>>
class Cluster <<Cụm>>
class AnalysisRun <<Lượt xử lý>>
class Evidence <<Bằng chứng>>
class Insight <<Nhận định>>
