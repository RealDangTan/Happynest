@startuml
!include ../style.iuml

left to right direction
actor "Quản lý sản phẩm" as PM
actor "Quản lý thành công\nkhách hàng" as CSM
actor "Nhân sự vận hành" as OPS
actor "Người phụ trách" as U
PM --|> U
CSM --|> U
OPS --|> U
rectangle "HappyNest" {
