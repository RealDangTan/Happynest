@startuml
!include ../style.iuml

start
:Che thông tin câu hỏi;
:Nạp bối cảnh: trường dữ liệu,\nbộ chủ đề, các cụm;
:Bước đầu cố định:\nđếm phản hồi theo chủ đề;
repeat
  #E9E9E9:Chọn công cụ và điều kiện lọc;
  if (Hợp lệ và\nkhông trùng?) then (có)
    :Chạy công cụ, lưu bằng chứng;
  else (không)
    :Ghi lỗi như một quan sát;
  endif
  #E9E9E9:Đánh giá bằng chứng mới;
repeat while (Chưa đủ và\ncòn giới hạn?) is (có) not (không)
:Chuyển sang tổng hợp;
stop

skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #FFFFFF
legend bottom
|<#D6E4F2>     | Người phụ trách quyết định |<#E9E9E9>     | Có gọi dịch vụ AI |<#FFFFFF>     | Chương trình xử lý |
endlegend

@enduml
