skinparam dpi 220
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam defaultFontColor #111111
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam roundCorner 10
skinparam ArrowColor #1F2933
skinparam ArrowFontSize 13
skinparam ArrowThickness 1.1
skinparam padding 2
skinparam nodesep 40
skinparam ranksep 45

skinparam actor {
  BorderColor #1F2933
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
  BorderThickness 1.2
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
  FontStyle bold
}
skinparam package {
  BackgroundColor #F6F8FA
  BorderColor #4B5563
  FontStyle bold
}
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
  StartColor #1F2933
  EndColor #1F2933
  BarColor #1F2933
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #1F2933
  FontSize 14
}
skinparam swimlane {
  BorderColor #6B7280
  TitleFontStyle bold
  TitleFontSize 14
}
skinparam partition {
  BorderColor #6B7280
  BackgroundColor #F6F8FA
}
skinparam sequence {
  LifeLineBorderColor #6B7280
  LifeLineBackgroundColor #E5E7EB
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #1F2933
  ParticipantFontStyle bold
  ActorBorderColor #1F2933
  ActorBackgroundColor #FFFFFF
  ActorFontStyle bold
  DatabaseBorderColor #1F2933
  DatabaseBackgroundColor #FFFFFF
  GroupBorderColor #4B5563
  GroupBackgroundColor #F3F4F6
  GroupHeaderFontStyle bold
  DividerBackgroundColor #F3F4F6
  ReferenceBackgroundColor #FFFFFF
  MessageAlign left
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
  HeaderBackgroundColor #E8EEF5
  AttributeFontSize 13
  StereotypeFontSize 12
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
  StartColor #1F2933
  EndColor #1F2933
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
}
skinparam node {
  BackgroundColor #F6F8FA
  BorderColor #1F2933
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #1F2933
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #9CA3AF
}
skinparam classAttributeIconSize 0
hide circle
