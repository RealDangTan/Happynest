# --- App ---
APP_ENV=dev                      # dev|prod
SECRET_KEY=changeme-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase session pooler; direct db.<ref>.supabase.co:5432 chỉ khi IPv6 OK) ---
# Code cũng chấp nhận alias DB_CONNECT_STRING (xem decisions.md 2026-08-24).
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM provider (OpenAI-compatible) ---
# LƯU Ý: base_url phải dạng BASE có đuôi /v1 (SDK tự nối /chat/completions, /embeddings).
# Embeddings dùng EMBEDDING_BASE_URL/EMBEDDING_API_KEY nếu có, fallback về LLM_*;
# EMBEDDING_DIMENSIONS là alias của EMBEDDING_DIM.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- MODEL ROUTING per use case (plan 30) ---
# Đổi model cho từng use case Ở ĐÂY (ID theo provider, vd openrouter: vendor/model).
# Rỗng = fallback về LLM_MODEL ở trên.
MODEL_SCHEMA_MAP=            # LISTEN import mapping (Gate #1)
MODEL_ENRICH=                # JEV-role: enrichment/classify (task đóng, chạy nhiều)
MODEL_TAXONOMY_GENERATE=     # GPT-role: sinh taxonomy proposal (task mở)
MODEL_TOPIC_RECOMMEND=       # GPT-role: đề xuất topic từ pool uncategorized
MODEL_CLUSTER_NAME=          # đặt tên cluster
MODEL_INSIGHT=               # generate insight (dự phòng)
MODEL_UNDERSTAND=            # UNDERSTAND graph (plan/evaluate/synthesize)
MODEL_ACT=                   # ACT agent generate

# --- Enrich engine (plan 32/34) ---
# "jev" CHỈ bật sau khi Spike S7 PASS (docs/plans/33-spike-s7-jev.md).
ENRICH_ENGINE=llm            # llm | jev
JEV_API_BASE=
JEV_API_KEY=
JEV_MODEL=jev-latest
ENRICH_TOPIC_CONFIDENCE_FLOOR=0.60   # dưới mốc này → UNCATEGORIZED

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# --- Pipeline thresholds (configurable per thesis spec) ---
CLASSIFY_CONFIDENCE_REVIEW_BELOW=0.60
HIGH_SEVERITY_CONFIDENCE_REVIEW_BELOW=0.75

# --- LISTEN import (plan 22): raw CSV lưu disk local (decisions 2026-08-28) ---
IMPORT_STORAGE_DIR=storage/imports
ANALYSIS_MAX_ITEMS_PER_RUN=100
ANALYSIS_BATCH_SIZE=10

# --- Tracing (Langfuse Cloud EU) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true    # false = offline demo kill switch
PROMPT_VERSION=v1
