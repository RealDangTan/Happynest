{
  "uid": "happynest-operations",
  "title": "HappyNest · Sức khỏe hệ thống",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "happynest",
    "observability"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "API, pipeline, host và log an toàn. Data source có thể đổi sang Grafana Cloud. Số đo là thực tế; panel chưa có lượt chạy sẽ hiện No data.",
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "HappyNest metrics",
          "value": "happynest-metrics"
        }
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "HappyNest logs",
          "value": "happynest-logs"
        }
      },
      {
        "name": "instance",
        "label": "Máy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(up{job=\"happynest-backend\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(happynest_http_requests_total, route)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation",
        "label": "Request / run UUID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Langfuse",
      "url": "https://cloud.langfuse.com",
      "targetBlank": true
    },
    {
      "title": "Supabase",
      "url": "https://supabase.com/dashboard",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "API · Server có phản hồi tốt không?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Backend có được thu thập?",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "1 = Alloy vừa scrape được API; 0 = scrape thất bại. Đây không phải uptime bên ngoài mạng.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "up{job=\"happynest-backend\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request / giây",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Lỗi server · 5xx",
      "type": "stat",
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Tỷ lệ 5xx trên request trong khoảng rate; 4xx được xem riêng ở bảng trạng thái.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "(100 * (sum(rate(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\",status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Số mẫu · khoảng đang xem",
      "type": "stat",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Từ counter scrape nên số tăng có thể được nội suy; file k6 chứa số request chính xác của thí nghiệm.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__range]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Đang xử lý",
      "type": "stat",
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(happynest_http_requests_in_progress{job=\"happynest-backend\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "API latency · p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Kết thúc khi gửi body xong; không gồm background job. Percentile ước lượng từ histogram; p99 với ít mẫu còn thiếu ổn định.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le)(rate(happynest_http_request_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le)(rate(happynest_http_request_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le)(rate(happynest_http_request_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "title": "p95 theo endpoint",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,route)(rate(happynest_http_request_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "HTTP status theo thời gian",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(status_code)(rate(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Request theo endpoint",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(route)(rate(happynest_http_requests_total{job=\"happynest-backend\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Pipeline · LISTEN / UNDERSTAND",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "title": "Run trong database · theo trạng thái",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Tổng snapshot toàn ứng dụng. running có thể đang chờ HITL; không đồng nghĩa đang dùng CPU.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "happynest_pipeline_runs{job=\"happynest-backend\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{pipeline}} · {{status}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Thời gian chạy chủ động · p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "LISTEN: mỗi lượt runner. UNDERSTAND: mỗi đoạn graph chạy tới interrupt/kết thúc; loại thời gian giữa hai lần duyệt. Chỉ gồm lượt chạy sau khi bật telemetry.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,pipeline)(rate(happynest_pipeline_execution_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{pipeline}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Database snapshot còn dùng được?",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "0 = lần đọc snapshot gần nhất lỗi; các count cũ được giữ lại và không nên coi là mới.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "happynest_database_snapshot_available{job=\"happynest-backend\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 15,
      "title": "Tuổi snapshot database",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 28,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "time() - happynest_database_snapshot_timestamp_seconds{job=\"happynest-backend\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 16,
      "title": "Feedback đã xử lý · LISTEN",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "happynest_pipeline_processed_feedbacks{job=\"happynest-backend\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 17,
      "title": "Lượt gọi model / phút",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Đếm từng attempt, kể cả retry. Đây không phải số run.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(call_type,outcome)(rate(happynest_llm_calls_total{job=\"happynest-backend\",instance=~\"$instance\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{call_type}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 18,
      "title": "LLM latency · p95 theo tác vụ",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,call_type)(rate(happynest_llm_call_duration_seconds_bucket{job=\"happynest-backend\",instance=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{call_type}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Token / phút",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "Usage do provider trả về; không tự suy ra chi phí hóa đơn.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(direction)(rate(happynest_llm_tokens_total{job=\"happynest-backend\",instance=~\"$instance\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "Máy chạy app · Windows hoặc VPS Linux",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "title": "CPU đang dùng",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "CPU của máy đang chạy app/Alloy; không phải CPU Supabase.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(instance)(rate(windows_cpu_time_total{job=\"happynest-host\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval]))) or 100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{job=\"happynest-host\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 22,
      "title": "RAM đang dùng",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - windows_memory_available_bytes{job=\"happynest-host\",instance=~\"$instance\"} / on(instance) windows_memory_physical_total_bytes{job=\"happynest-host\",instance=~\"$instance\"}) or 100 * (1 - node_memory_MemAvailable_bytes{job=\"happynest-host\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"happynest-host\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 23,
      "title": "Đĩa trống",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 43,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "windows_logical_disk_free_bytes{job=\"happynest-host\",instance=~\"$instance\"} or node_filesystem_avail_bytes{job=\"happynest-host\",instance=~\"$instance\",fstype!~\"tmpfs|overlay\"}",
          "refId": "A",
          "legendFormat": "{{volume}}{{mountpoint}}"
        }
      ]
    },
    {
      "id": 24,
      "title": "Log · lọc bằng endpoint hoặc mã request/run",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 25,
      "title": "Lỗi và cảnh báo",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "description": "Metadata an toàn; không lưu body, query, cookie, exception message hay locals. Mở dòng để xem request_id/run_id và frames.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"happynest-backend\",instance=~\"$instance\",level=~\"ERROR|WARNING\"} | json",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "title": "Tìm request hoặc run",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "description": "Nhập UUID vào bộ lọc correlation; để trống để xem toàn bộ. ID chỉ là field log, không là metric/Loki label.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"happynest-backend\",instance=~\"$instance\"} |= \"$correlation\" | json",
          "refId": "A"
        }
      ]
    }
  ]
}
